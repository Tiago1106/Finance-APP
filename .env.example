# Copie para .env.local e preencha os valores. Nunca commitar .env.local.

# --- Supabase --------------------------------------------------------------
# Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Project Settings > API > service_role (segredo — apenas server-side, nunca no client)
SUPABASE_SERVICE_ROLE_KEY=

# Connection string do Postgres — Project Settings > Database > Connection string,
# aba "Transaction pooler" (NAO "Direct connection"). O host de conexao direta
# (db.<ref>.supabase.co) so resolve por IPv6 e falha com ENOTFOUND nas funcoes
# serverless da Vercel (sem saida IPv6). Use o host do pooler
# (aws-<n>-<regiao>.pooler.supabase.com:6543), com usuario "postgres.<project-ref>".
DATABASE_URL=

# --- Telegram ----------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Header X-Telegram-Bot-Api-Secret-Token — valida que a requisicao do webhook veio do Telegram.
TELEGRAM_WEBHOOK_SECRET=
# Username do bot (sem @), opcional — habilita o deep link "Abrir o bot" na tela Perfil.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# --- Anthropic (IA de extracao) ----------------------------------------------
ANTHROPIC_API_KEY=

# --- Cron (Vercel Cron) -------------------------------------------------------
# Enviado no header Authorization das rotas em app/api/cron.
CRON_SECRET=
